# ============================================================
#  CHEATGAMEOS - ENVIRONMENT
#  Trên Render: điền vào tab "Environment Variables"
#  Trên local : copy thành .env
# ============================================================

# ---------- TELEGRAM ----------
TOKEN_TELEGRAM=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TEN_BOT_TELEGRAM=CheatGameOS Bot
USERNAME_BOT_TELEGRAM=cheatgameos_bot
ALLOWED_IDS=123456789

CMD_START=start
CMD_HELP=help
CMD_ID=id
CMD_COOKIE=cookie
CMD_MYCOOKIES=mycookies
CMD_CANCEL=cancel

# ---------- API KEY ----------
API_KEY=cheatgame
SECRET_KEY=change_me_random_32_chars_minimum

# ---------- WEB ----------
WEB_URL=https://cheatgameos-web.onrender.com
PORT=8080

# ---------- SUPABASE ----------
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_KEY=eyJhbGci...
SUPABASE_BUCKET_SELFIES=selfies
SUPABASE_BUCKET_COOKIES=cookies
SUPABASE_TABLE_USERS=cg_users
SUPABASE_TABLE_VERIFICATIONS=cg_verifications
SUPABASE_TABLE_AUDIT=cg_audit_log

# ---------- EXTRACTOR ----------
ZIP_PASSWORD=cheatgame
DATA_RETENTION_DAYS=7
DOWNLOAD_TOKEN_TTL=300
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=60

# ---------- PROXY ----------
DEFAULT_PROXY=
ALLOW_USER_PROXY=true

# ---------- IP AUTO ----------
DEFAULT_MODE=auto
SHOW_RENDER_IP=true

# ---------- SITES ----------
ENABLE_FACEBOOK=true
ENABLE_TIKTOK=true
ENABLE_INSTAGRAM=true

# ---------- RATE LIMIT ----------
RATE_LIMIT_PER_DAY=5
